{
  "name": "atelier",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:types": "json2ts -i ../../api/models -o src/types/generated --cwd ../../api/models",
    "generate:api-client": "swagger-typescript-api generate --path ../../api/openapi.yaml --output src/api/generated --name generated.ts --axios"
  },
  "dependencies": {
    "@atelier/bookshelf": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "axios": "catalog:",
    "i18next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "json-schema-to-typescript": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "swagger-typescript-api": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
